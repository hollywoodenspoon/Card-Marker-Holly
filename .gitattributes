# Same line endings on every computer (Windows included), so text files and
# the Help pages' checks behave the same everywhere.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.xlsx binary
*.bat text eol=crlf
